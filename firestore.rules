rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function logado() { return request.auth != null && request.auth.token.email_verified == true; }
    function dono() { return logado() && email() == 'eduardoduartecostaduarte@gmail.com'; }
    function temAcesso() { return exists(/databases/$(database)/documents/acessos/$(email())); }
    function liberado() { return dono() || (logado() && temAcesso()); }
    function admin() {
      return dono() || (logado() && temAcesso()
        && get(/databases/$(database)/documents/acessos/$(email())).data.papel == 'admin');
    }

    // Lista de e-mails liberados (só cliente entra). O id do documento é o e-mail em minúsculas.
    match /acessos/{mail} {
      allow get: if logado() && (mail == email() || admin());
      allow list, write: if admin();
    }

    // Ficha de quem criou conta (nome, setor, e-mail).
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if admin();
    }

    // Dados do desafio: participantes, tempos, configurações.
    match /eventos/{evento}/{document=**} {
      allow read, write: if liberado();
    }
  }
}
